# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialpilot_v2"
# Secreto para firmar las sesiones (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-esto"
# URL pública de la app
APP_URL="http://localhost:3000"
# "mock" simula las redes sociales. Las integraciones reales llegan en la siguiente fase.
PLATFORM_MODE="mock"
