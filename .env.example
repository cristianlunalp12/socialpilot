# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialpilot"
APP_URL="http://localhost:3000"
# 32+ random chars: openssl rand -base64 32
AUTH_SECRET="change-me-change-me-change-me-change-me"
# 32 bytes in base64 for AES-256-GCM token encryption: openssl rand -base64 32
ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTES"

# "mock" simulates every platform locally (no credentials needed). "live" calls the real APIs.
PLATFORM_MODE="mock"

# --- Claude (copy generation, comment analysis, recommendations) ---
ANTHROPIC_API_KEY=""

# --- Meta (Facebook Pages + Instagram Graph API) ---
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

# --- TikTok (Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Google / YouTube (Data API v3 + YouTube Analytics API) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
